# General

DOMAIN_URL=http://localhost:8000/ # Domain URL

# False In Production
DEBUG="True"
# Comma-Separated Browser Origins Allowed To Call /native-api/ (Empty = None In Production, All In DEBUG)
CORS_ALLOWED_ORIGINS=""
# Comma-Separated Extra Origins Trusted For CSRF, e.g. "https://wesiq.com,https://your-domain.ngrok-free.dev"
CSRF_TRUSTED_ORIGINS=""
# True Only When A Reverse Proxy (nginx, Traefik, ...) Sits In Front Of Django And Overwrites X-Forwarded-* Headers
BEHIND_PROXY="False"
# Header Your Proxy Sets To The Real Client IP, e.g. "HTTP_X_REAL_IP" (Empty = REMOTE_ADDR)
RATELIMIT_IP_META_KEY=""
# True In Production
SECURE_SSL_REDIRECT="False"
# True In Production
SESSION_COOKIE_SECURE="False"
# True In Production
CSRF_COOKIE_SECURE="False"
# 31536000 (One Year) In Production
SECURE_HSTS_SECONDS="0"
# True In Production
SECURE_HSTS_INCLUDE_SUBDOMAINS="False"
# True In Production
SECURE_HSTS_PRELOAD="False"

# Long Random Value (At Least 32 Characters) - Startup Fails Without It When DEBUG Is False
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY="SECRET_KEY"
ALLOWED_HOSTS="localhost,127.0.0.1"

# Database (PostgreSQL)

POSTGRES_DB="POSTGRES_DB"
POSTGRES_USER="POSTGRES_USER"
POSTGRES_PASSWORD="POSTGRES_PASSWORD"
# Postgis For GeoDjango
DATABASE_URL="postgis://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB"

# Celery & Redis
# Django Cache (Uses Database 1 Of This Server), Channels Layer And Default Celery Broker. Docker: redis://redis:6379/0, VM: redis://127.0.0.1:6379/0
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"

# Mail (Gmail)

EMAIL_HOST = "smtp.gmail.com"
EMAIL_HOST_USER = "example@example.com"
EMAIL_HOST_PASSWORD = "pa$$w0rd"
EMAIL_PORT = "587"
# False On PORT 465
EMAIL_USE_TLS = "True"
EMAIL_BACKEND = "django.core.mail.backends.smtp.EmailBackend"
# Sender Shown In E-mails (Defaults To "Wesiq <noreply@wesiq.com>")
DEFAULT_FROM_EMAIL = "Wesiq <noreply@wesiq.com>"

# Google reCAPTCHA V3

RECAPTCHA_SITE_KEY="RECAPTCHA_SITE_KEY"
RECAPTCHA_SECRET_KEY="RECAPTCHA_SECRET_KEY"

# Stripe

STRIPE_PUBLISHABLE_KEY="STRIPE_PUBLISHABLE_KEY"
STRIPE_SECRET_KEY="STRIPE_SECRET_KEY"
# docker run --rm -it stripe/stripe-cli listen --forward-to host.docker.internal:8000/stripe/webhook/ For Temporary Secret Or Register Testing Domain On Ngrok For Static Secret
STRIPE_WEBHOOK_SECRET="STRIPE_WEBHOOK_SECRET"

# Admin

ADMIN_URL="admin/"

# RevenueCat (Native App In-App Purchases) - Same Value As The Webhook "Authorization" Header In The RevenueCat Dashboard
REVENUECAT_WEBHOOK_AUTH="REVENUECAT_WEBHOOK_AUTH"
# RevenueCat Secret API Key ("sk_..."), Used To Read The Current Subscription State
REVENUECAT_SECRET_KEY="REVENUECAT_SECRET_KEY"

# Ngrok (Local Tunnel For Webhooks / Mobile Testing) - Used By run_dev.sh / run_dev.bat
NGROK_AUTHTOKEN="NGROK_AUTHTOKEN"
NGROK_DOMAIN="your-domain.ngrok-free.dev"

# Flower (Celery Monitoring) - "user:password"; Flower Reads This Automatically
FLOWER_BASIC_AUTH="admin:change-me"
