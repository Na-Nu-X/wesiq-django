#: app/api/views.py:480 app/views.py:1317 app/views.py:2080
#, python-format
msgid ""
"ďakujeme za Vašu registráciu. Pre dokončenie procesu registrácie a aktiváciu "
"Vášho účtu je potrebné overiť Vašu e-mailovú adresu. Kliknutím na nižšie "
"uvedený odkaz potvrdíte svoj e-mail a budete automaticky prihlásený do "
"svojho nového účtu.\n"
"\n"
"%(domain)s%(language)s?verification-code=%(verification_code)s&id=%(id)s\n"
"\n"
"Tento odkaz je platný nasledujúcich 24 hodín. Po uplynutí tohto času bude z "
"bezpečnostných dôvodov potrebné registráciu zopakovať. Ak ste registráciu "
"nevykonali Vy, tento e-mail prosím ignorujte.\n"
"Tím Wesiq."
msgstr ""
"merci pour votre inscription ! Pour finaliser votre inscription et activer "
"votre compte, veuillez confirmer votre adresse e-mail. Cliquez sur le lien "
"ci-dessous : vous serez ensuite automatiquement connecté à votre nouveau "
"compte.\n"
"\n"
"%(domain)s%(language)s?verification-code=%(verification_code)s&id=%(id)s\n"
"\n"
"Ce lien est valable 24 heures. Passé ce délai, vous devrez vous réinscrire "
"pour des raisons de sécurité. Si vous ne vous êtes pas inscrit, veuillez "
"ignorer cet e-mail.\n"
"L'équipe Wesiq"

#: app/api/views.py:481 app/views.py:1318 app/views.py:2081
#, python-format
msgid ""
"ďakujeme za Vašu registráciu. Pre dokončenie procesu registrácie a aktiváciu "
"Vášho účtu je potrebné overiť Vašu e-mailovú adresu. Kliknutím na <a "
"href=\"%(domain)s%(language)s?verification-"
"code=%(verification_code)s&id=%(id)s\" title=\"Dokončiť registráciu\" "
"target=\"_blank\">tento</a> odkaz potvrdíte svoj e-mail a budete automaticky "
"prihlásený do svojho nového účtu. Tento odkaz je platný nasledujúcich 24 "
"hodín. Po uplynutí tohto času bude z bezpečnostných dôvodov potrebné "
"registráciu zopakovať."
msgstr ""
"merci pour votre inscription ! Pour finaliser votre inscription et activer "
"votre compte, veuillez confirmer votre adresse e-mail. Cliquez sur <a "
"href=\"%(domain)s%(language)s?verification-"
"code=%(verification_code)s&id=%(id)s\" title=\"Finaliser l'inscription\" "
"target=\"_blank\">ce lien</a> : vous serez ensuite automatiquement connecté "
"à votre nouveau compte. Ce lien est valable 24 heures. Passé ce délai, vous "
"devrez vous réinscrire pour des raisons de sécurité."

#: app/api/views.py:482 app/views.py:1319 app/views.py:2082
msgid "Ak ste registráciu nevykonali Vy, tento e-mail prosím ignorujte."
msgstr "Si vous ne vous êtes pas inscrit, veuillez ignorer cet e-mail."

